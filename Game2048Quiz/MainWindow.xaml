<Window x:Class="Game2048Quiz.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="2048: Информатика" Height="500" Width="500" 
        KeyDown="Window_KeyDown" WindowStartupLocation="CenterScreen">

    <Grid Background="#faf8ef">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель: Счет -->
        <Border Grid.Row="0" Background="#bbada0" Padding="10" Margin="10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="ОЧКИ: " FontSize="24" FontWeight="Bold" Foreground="White"/>
                <TextBlock x:Name="TxtScore" Text="0" FontSize="24" FontWeight="Bold" Foreground="White"/>
            </StackPanel>
        </Border>

        <!-- Игровое поле -->
        <!-- UniformGrid сам выровняет ячейки, а Grid внутри позволит красиво их стилизовать -->
        <Grid x:Name="GameContainer" Grid.Row="1" Margin="10">
            <!-- Здесь программно создадим сетку -->
        </Grid>
    </Grid>
</Window>
<Window x:Class="Game2048Quiz.StartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="2048: Информатика - Выбор сложности" Height="450" Width="700" 
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen">

    <Grid Background="#faf8ef">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.5*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая часть: Выбор сложности -->
        <Border Grid.Column="0" Background="#bbada0" Padding="20">
            <!-- Левая часть: Выбор сложности -->
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Выберите сложность" FontSize="20" FontWeight="Bold" Foreground="White" Margin="0,0,0,20"/>

                <!-- Убедитесь, что здесь есть Tag="Easy" -->
                <RadioButton x:Name="RbEasy" Content="Лёгкий" FontSize="18" Foreground="White" Margin="5" Checked="Difficulty_Checked" Tag="Easy"/>

                <!-- Убедитесь, что здесь есть Tag="Medium" -->
                <RadioButton x:Name="RbMedium" Content="Средний" FontSize="18" Foreground="White" Margin="5" IsChecked="True" Checked="Difficulty_Checked" Tag="Medium"/>

                <!-- И так далее для остальных -->
                <RadioButton x:Name="RbHard" Content="Сложный" FontSize="18" Foreground="White" Margin="5" Checked="Difficulty_Checked" Tag="Hard"/>
                <RadioButton x:Name="RbInsane" Content="Безумие" FontSize="18" Foreground="White" Margin="5" Checked="Difficulty_Checked" Tag="Insane"/>

                <Button Content="НАЧАТЬ ИГРУ" FontSize="20" FontWeight="Bold" Margin="0,30,0,0" Height="50" Click="BtnStart_Click" Background="#8f7a66" Foreground="White"/>
            </StackPanel>
        </Border>

        <!-- Правая часть: Описание и Картинка -->
        <Grid Grid.Column="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Картинка справа сверху -->
            <Border Grid.Row="0" Background="#cdc1b4" CornerRadius="10" Margin="0,0,0,20" Padding="10">
                <!-- Stretch="Uniform" сохраняет пропорции картинки -->
                <Image x:Name="ImgPreview" Stretch="Uniform"/>
            </Border>

            <!-- Описание справа снизу -->
            <Border Grid.Row="1" Background="#eee4da" Padding="15" CornerRadius="5">
                <StackPanel>
                    <TextBlock x:Name="TxtTitle" Text="Средний" FontSize="24" FontWeight="Bold" Foreground="#776e65"/>
                    <TextBlock x:Name="TxtDescription" TextWrapping="Wrap" Margin="0,10,0,0" FontSize="14" Foreground="#776e65" Text="Стандартные вопросы по программированию и сетям. Множитель очков: x1"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
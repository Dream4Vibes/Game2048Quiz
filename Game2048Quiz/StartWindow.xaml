<Window x:Class="Game2048Quiz.StartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="2048: Информатика - Выбор сложности" 
        Height="650" Width="1050" 
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen">

    <Grid Background="#faf8ef">
        <Grid.ColumnDefinitions>
            <!-- Левая колонка (Меню) -->
            <ColumnDefinition Width="2*"/>
            <!-- Правая колонка (Картинка + Описание) -->
            <ColumnDefinition Width="1.2*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая часть: Выбор сложности -->
        <!-- Левая часть: Выбор сложности -->
        <Border Grid.Column="0" Background="#bbada0" Padding="30">
            <!-- Используем Grid, чтобы закрепить кнопку "Создатели" внизу -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <!-- Основной контент -->
                    <RowDefinition Height="Auto"/>
                    <!-- Кнопка Создатели -->
                </Grid.RowDefinitions>

                <!-- Стек с кнопками выбора сложности -->
                <StackPanel Grid.Row="0" VerticalAlignment="Center">
                    <TextBlock Text="Выбери свой путь" FontSize="28" FontWeight="Bold" Foreground="White" Margin="0,0,0,40" TextAlignment="Center"/>

                    <RadioButton x:Name="RbEasy" Content="Мама говорит &quot;я умный&quot;" FontSize="24" Foreground="White" Margin="0,10" Checked="Difficulty_Checked" Tag="Easy"/>
                    <RadioButton x:Name="RbMedium" Content="В школе я хорошист" FontSize="24" Foreground="White" Margin="0,10" IsChecked="True" Checked="Difficulty_Checked" Tag="Medium"/>
                    <RadioButton x:Name="RbHard" Content="Я программист, но не супер..." FontSize="24" Foreground="White" Margin="0,10" Checked="Difficulty_Checked" Tag="Hard"/>
                    <RadioButton x:Name="RbInsane" Content="Зови меня &quot;Третьяк&quot;, малыш" FontSize="24" Foreground="White" Margin="0,10" Checked="Difficulty_Checked" Tag="Insane"/>

                    <Button x:Name="BtnStart" Content="ПОЕХАЛИ!" FontSize="26" FontWeight="Bold" Margin="0,50,0,0" Height="60" Click="BtnStart_Click" Background="#8f7a66" Foreground="White" BorderThickness="0"/>
                </StackPanel>

                <!-- Кнопка Создатели внизу -->
                <Button Grid.Row="1" Content="Создатели" 
                Height="40" FontSize="16" 
                Background="Transparent" 
                Foreground="White" 
                BorderBrush="White" 
                BorderThickness="2"
                Click="BtnCredits_Click"
                Margin="0,20,0,0"/>
            </Grid>
        </Border>

        <!-- Правая часть: Картинка и Описание -->
        <Grid Grid.Column="1" Margin="20">
            <Grid.RowDefinitions>
                <!-- Картинка занимает верхнюю часть (чуть уменьшили долю) -->
                <RowDefinition Height="1.8*"/>

                <!-- Описание занимает нижнюю часть (УВЕЛИЧИЛИ ДОЛЮ) -->
                <RowDefinition Height="1.4*"/>
            </Grid.RowDefinitions>

            <!-- Картинка справа сверху -->
            <Border Grid.Row="0" Background="#cdc1b4" CornerRadius="15" Margin="0,0,0,15" Padding="5">
                <Image x:Name="ImgPreview" Stretch="Uniform"/>
            </Border>

            <!-- Описание справа снизу (Увеличенный блок) -->
            <Border Grid.Row="1" Background="#eee4da" Padding="20" CornerRadius="10">
                <!-- ScrollViewer позволит прокрутить текст, если он ОЧЕНЬ длинный -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Название уровня -->
                        <TextBlock x:Name="TxtTitle" 
                                   Text="Medium" 
                                   FontSize="26" FontWeight="Bold" 
                                   Foreground="#776e65" 
                                   TextAlignment="Center" 
                                   TextWrapping="Wrap"/>

                        <!-- Описание уровня -->
                        <TextBlock x:Name="TxtDescription" 
                                   TextWrapping="Wrap" 
                                   Margin="0,15,0,0" 
                                   FontSize="17" 
                                   Foreground="#776e65" 
                                   Text="Описание уровня..." 
                                   TextAlignment="Center"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
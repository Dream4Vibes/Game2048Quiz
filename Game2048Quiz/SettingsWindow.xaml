<Window x:Class="Game2048Quiz.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Пауза" Height="300" Width="350" 
        ResizeMode="NoResize" 
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" 
        AllowsTransparency="True"
        Background="Transparent">

    <!-- Декоративный контейнер с тенью и скруглениями -->
    <Border Background="#faf8ef" CornerRadius="15" BorderBrush="#bbada0" BorderThickness="3" Margin="10">
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.3" BlurRadius="10" ShadowDepth="0"/>
        </Border.Effect>

        <StackPanel VerticalAlignment="Center" Margin="20">
            <TextBlock Text="МЕНЮ" FontSize="28" FontWeight="Bold" Foreground="#776e65" HorizontalAlignment="Center" Margin="0,0,0,30"/>

            <!-- Кнопка "Главное меню" -->
            <Button Content="Главное меню" 
                    Height="50" FontSize="20" 
                    Background="#8f7a66" Foreground="White" 
                    BorderThickness="0" 
                    Click="BtnMainMenu_Click" Margin="0,5"/>

            <!-- Добавь эту кнопку перед кнопкой "Выход" или после -->
            <Button Content="Потрогать траву" 
        Height="50" FontSize="20" 
        Background="#FF80EF16" Foreground="White" 
        BorderThickness="0" 
        Click="BtnTouchGrass_Click" Margin="0,5"/>

            <!-- Кнопка "Выход из игры" -->
            <Button Content="Выход из игры" 
                    Height="50" FontSize="20" 
                    Background="#f67c5f" Foreground="White" 
                    BorderThickness="0" 
                    Click="BtnExit_Click" Margin="0,5"/>
        </StackPanel>
    </Border>
</Window>
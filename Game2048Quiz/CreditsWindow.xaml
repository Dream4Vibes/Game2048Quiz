<Window x:Class="Game2048Quiz.CreditsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Создатели" 
        Height="500" Width="450" 
        ResizeMode="NoResize" 
        WindowStartupLocation="CenterOwner"
        Background="#faf8ef">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" Text="КОМАНДА ПРОЕКТА" 
                   FontSize="28" FontWeight="Bold" 
                   Foreground="#776e65" 
                   HorizontalAlignment="Center" 
                   Margin="0,0,0,20"/>

        <!-- Список людей -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Человек 1 -->
                <Border Background="#eee4da" Padding="15" CornerRadius="10" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="Третьяков Кирилл Олегович" FontSize="18" FontWeight="Bold" Foreground="#776e65"/>
                        <TextBlock Text="Главный разработчик." FontSize="14" Foreground="#776e65" Margin="0,5,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Человек 2 -->
                <Border Background="#eee4da" Padding="15" CornerRadius="10" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="Краснопёров Алексей Андреевич" FontSize="18" FontWeight="Bold" Foreground="#776e65"/>
                        <TextBlock Text="Главный тестер (наиграл в общей сумме 5 часов в этот шедевр) и креативный директор." FontSize="14" Foreground="#776e65" Margin="0,5,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Человек 3 -->
                <Border Background="#eee4da" Padding="15" CornerRadius="10" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="Шилин Дмитрий Александрович" FontSize="18" FontWeight="Bold" Foreground="#776e65"/>
                        <TextBlock Text="Рейтинговое агентство (он вырезал 99% шуток Краснопёрова Алексея и 18+ контент от Кирилла Третьякова)." FontSize="14" Foreground="#776e65" Margin="0,5,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Человек 4 -->
                <Border Background="#eee4da" Padding="15" CornerRadius="10" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="Батазов Иван Дмитриевич" FontSize="18" FontWeight="Bold" Foreground="#776e65"/>
                        <TextBlock Text="Графический дизайнер, который создал топовую иконку для приложения" FontSize="14" Foreground="#776e65" Margin="0,5,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Человек 4 -->
                <Border Background="#eee4da" Padding="15" CornerRadius="10" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="Федотова Анастасия (stupid_owo)" FontSize="18" FontWeight="Bold" Foreground="#776e65"/>
                        <TextBlock Text="Мы просто передаём ей привет (от Алексея К. А. и Кирилла Т. О.)." FontSize="14" Foreground="#776e65" Margin="0,5,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Кнопка закрытия -->
        <Button Grid.Row="2" Content="Круто!" 
                Height="50" FontSize="20" FontWeight="Bold"
                Background="#8f7a66" Foreground="White" 
                BorderThickness="0" 
                Click="BtnClose_Click"/>
    </Grid>
</Window>
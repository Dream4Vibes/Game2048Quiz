<Window x:Class="Game2048Quiz.QuizWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вопрос" 
        Height="500" Width="700" 
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">

    <Grid Background="WhiteSmoke">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Текст вопроса -->
        <TextBlock x:Name="TxtQuestion" Grid.Row="0" 
                   Text="Здесь будет вопрос?" 
                   FontSize="24" FontWeight="Bold" 
                   TextWrapping="Wrap" Margin="30" 
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <!-- Кнопки ответов -->
        <StackPanel Grid.Row="1" Margin="30">
            <Button x:Name="BtnAnswer1" Content="Вариант 1" Height="55" Margin="0,8" Click="BtnAnswer_Click" Tag="0" FontSize="20"/>
            <Button x:Name="BtnAnswer2" Content="Вариант 2" Height="55" Margin="0,8" Click="BtnAnswer_Click" Tag="1" FontSize="20"/>
            <Button x:Name="BtnAnswer3" Content="Вариант 3" Height="55" Margin="0,8" Click="BtnAnswer_Click" Tag="2" FontSize="20"/>
            <Button x:Name="BtnAnswer4" Content="Вариант 4" Height="55" Margin="0,8" Click="BtnAnswer_Click" Tag="3" FontSize="20"/>
        </StackPanel>
    </Grid>
</Window>
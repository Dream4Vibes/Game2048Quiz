<Window x:Class="Game2048Quiz.QuizWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вопрос по информатике" Height="350" Width="400" 
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">

    <Grid Background="WhiteSmoke" Margin="0,0,0,-40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Текст вопроса -->
        <TextBlock x:Name="TxtQuestion" Grid.Row="0" 
                   Text="Здесь будет вопрос?" 
                   FontSize="18" FontWeight="Bold" 
                   TextWrapping="Wrap" Margin="20" 
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <!-- Кнопки ответов -->
        <StackPanel Grid.Row="1" Margin="20">
            <Button x:Name="BtnAnswer1" Content="Вариант 1" Height="40" Margin="0,5" Click="BtnAnswer_Click" Tag="0"/>
            <Button x:Name="BtnAnswer2" Content="Вариант 2" Height="40" Margin="0,5" Click="BtnAnswer_Click" Tag="1"/>
            <Button x:Name="BtnAnswer3" Content="Вариант 3" Height="40" Margin="0,5" Click="BtnAnswer_Click" Tag="2"/>
            <Button x:Name="BtnAnswer4" Content="Вариант 4" Height="40" Margin="0,5" Click="BtnAnswer_Click" Tag="3"/>
        </StackPanel>
    </Grid>
</Window>